{
  "_README": "ONE config file drives the whole tracker (scraper + dashboard). Edit it by hand, or generate it from your CV using docs/cv-to-config-prompt.md. After editing, commit it and re-run the workflows. All matching is case-insensitive substring on the JOB TITLE unless noted.",

  "profile": {
    "title": "Sakalesh Job Tracker",
    "subtitle": "India · Bengaluru · Remote",
    "emoji": "🧪"
  },

  "keywords": {
    "_comment": "A job TITLE is kept if it contains any of these. Use full words; multi-word phrases match as substrings.",
    "include": [
        "software engineer intern",
        "software engineering intern",
        "software developer intern",
        "software development intern",

        "frontend engineer intern",
        "frontend developer intern",
        "front-end engineer intern",
        "front-end developer intern",
        "react developer intern",
        "react engineer intern",
        "web developer intern",

        "backend engineer intern",
        "backend developer intern",
        "back-end engineer intern",
        "back-end developer intern",
        "java developer intern",
        "java engineer intern",

        "full stack engineer intern",
        "full stack developer intern",
        "full-stack engineer intern",
        "full-stack developer intern",

        "web development intern",
        "application developer intern",
        "application engineer intern"
    ],
    "_exclude_comment": "Titles containing any of these are dropped (junior/off-field roles).",
    "exclude": [
        "senior",
        "sr.",
        "sr ",
        "lead",
        "staff",
        "principal",
        "manager",
        "director",
        "architect",
        "5+ years",
        "4+ years",
        "3+ years",
        "experienced professional"
    ]
  },

  "search_terms": {
    "_comment": "Queries sent to the job boards' search boxes. Broader than 'keywords' (which then filters the titles).",
    "linkedin": [
        "software engineer intern",
        "software developer intern",
        "software engineering intern",
        "frontend developer intern",
        "frontend engineer intern",
        "react developer intern",
        "backend developer intern",
        "backend engineer intern",
        "java developer intern",
        "java engineer intern",
        "full stack developer intern",
        "full stack engineer intern",
        "web developer intern"
    ],
    "indeed": [
        "software engineer intern",
        "software developer intern",
        "frontend developer intern",
        "backend developer intern",
        "java developer intern",
        "full stack developer intern"
    ],
    "glassdoor": [
        "software engineer intern",
        "software developer intern",
        "frontend developer intern",
        "backend developer intern",
        "java developer intern",
        "full stack developer intern"
    ],

    "ziprecruiter": [
        "software engineer intern",
        "software developer intern",
        "frontend developer intern",
        "backend developer intern",
        "java developer intern",
        "full stack developer intern"
    ],

    "google_jobs": [
        "software engineer intern",
        "software developer intern",
        "frontend developer intern",
        "backend developer intern",
        "java developer intern",
        "full stack developer intern"
    ],

    "hiring_cafe": [
        "software engineer intern",
        "software developer intern",
        "frontend developer intern",
        "backend developer intern",
        "java developer intern",
        "full stack developer intern"
    ],

    "workday": [
        "software engineer intern",
        "software developer intern",
        "frontend engineer intern",
        "backend engineer intern",
        "java developer intern",
        "full stack engineer intern"
    ]
  },

  "locations": {
    "_comment": "LinkedIn needs a geoId (find via the guest endpoint; leave blank to let LinkedIn resolve the text). JobSpy-backed boards such as Indeed, Glassdoor, ZipRecruiter, and Google Jobs need a location + country (USA, Australia, Canada, GB...). HiringCafe currently uses its public US SEO route; locations.hiring_cafe is kept for compatibility. The map auto-fits to wherever the jobs are.",
    "linkedin": [
        {
        "name": "Bengaluru",
        "location": "Bengaluru, Karnataka, India",
        "geoId": ""
        },
        {
        "name": "India",
        "location": "India",
        "geoId": ""
        }
    ],

    "indeed": [
        {
        "location": "Bengaluru, Karnataka",
        "country": "India"
        },
        {
        "location": "India",
        "country": "India"
        }
    ],

    "glassdoor": [
        {
        "location": "Bengaluru, Karnataka",
        "country": "India"
        },
        {
        "location": "India",
        "country": "India"
        }
    ],

    "ziprecruiter": [
        {
        "location": "India",
        "country": "India"
        }
    ],

    "google_jobs": [
        {
        "location": "Bengaluru, Karnataka, India",
        "country": "India"
        },
        {
        "location": "India",
        "country": "India"
        }
    ],

    "hiring_cafe": [
        {
        "location": "India"
        }
    ]
  },

  "location_filter": {
    "_comment": "Case-insensitive substrings matched against a job's location text. Used to post-filter boards that don't support geo-scoping at the API level: the curated direct-ATS sweep, and NEOGOV/GovernmentJobs.com (a nationwide board). Keep this in sync with your locations.* entries above.",
    "terms": [
        "india",
        "bengaluru",
        "bangalore",
        "karnataka",
        "remote",
        "work from home",
        "hybrid"
    ]
  },

  "google_jobs": {
    "_comment": "Optional exact Google Jobs queries. Leave empty to auto-build queries such as '<term> jobs near <location> since yesterday' from search_terms.google_jobs and locations.google_jobs. If the free JobSpy path is blocked, set SERPAPI_API_KEY or OXYLABS_USERNAME/OXYLABS_PASSWORD as GitHub Actions secrets for an API fallback.",
    "queries": [],
    "serpapi_api_key": "",
    "oxylabs_username": "",
    "oxylabs_password": ""
  },

  "jobspy": {
    "_comment": "Optional. Prefer JOBSPY_PROXIES as a GitHub Actions secret/env var for private proxy credentials. Use only if JobSpy-backed boards are blocked.",
    "proxies": [],
    "user_agent": ""
  },

  "hiring_cafe": {
    "_comment": "Uses HiringCafe's public SSR /jobs/<query> pages. max_pages caps SEO pagination per query; the public route currently defaults to United States.",
    "max_pages": 3
  },

  "employers": {
    "_priority_comment": "Optional. Companies worth a daily 'priority' digest even on a quiet day (case-insensitive substring match on the company name). Leave [] to disable.",
