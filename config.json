  "priority_topics": {
    "_comment": "Optional. Roles touching these get a gold ★ + a 'Priority topics' filter on the dashboard. [name, regex] pairs.",
    "terms": [
        ["Java", "\\bjava\\b"],
        ["React", "\\breact\\b|react\\.js|reactjs"],
        ["Full Stack", "full[\\s-]?stack"],
        ["Backend", "backend|back[\\s-]?end"],
        ["Frontend", "frontend|front[\\s-]?end"],
        ["REST APIs", "rest[\\s-]?api|restful|web api"],

        ["Node.js", "node\\.?(js)?"],
        ["Express.js", "express\\.?(js)?"],
        ["FastAPI", "\\bfastapi\\b"],
        ["Flask", "\\bflask\\b"],

        ["Python", "\\bpython\\b"],
        ["JavaScript", "\\bjavascript\\b"],
        ["TypeScript", "\\btypescript\\b"],

        ["SQL / Database", "\\bsql\\b|mysql|postgresql"],
        ["MongoDB", "\\bmongodb\\b"],

        ["HTML", "\\bhtml\\b"],
        ["CSS", "\\bcss\\b"],
        ["Tailwind CSS", "tailwind[\\s-]?css"],

        ["Docker", "\\bdocker\\b"],
        ["Git", "\\bgit\\b"],
        ["GitHub", "\\bgithub\\b"],

        ["Scikit-learn", "scikit[\\s-]?learn|sklearn"],
        ["TensorFlow / Keras", "tensorflow|keras"],
        ["Pandas", "\\bpandas\\b"],
        ["NumPy", "\\bnumpy\\b"],

        ["Cloud", "\\baws\\b|amazon web services|azure|gcp|google cloud"],
        ["AI / ML", "\\bai\\b|artificial intelligence|machine learning|llm|generative ai"]
    ]
  },

  "role_categories": {
    "_comment": "Dashboard 'Role' filter buckets, applied top-to-bottom to each title. [name, regex] pairs.",
    "terms": [
        ["Software Engineering", "software engineer|software developer|software development|software engineering"],

        ["Full Stack", "full[\\s-]?stack"],

        ["Frontend", "frontend|front[\\s-]?end|react developer|react engineer|web developer"],

        ["Backend", "backend|back[\\s-]?end|backend developer|backend engineer"],

        ["Java", "\\bjava\\b|spring[\\s-]?boot|spring developer|java developer|java engineer"],

